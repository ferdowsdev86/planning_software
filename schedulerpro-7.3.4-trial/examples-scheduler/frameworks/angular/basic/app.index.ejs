<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%- data.title %></title>
  <base href="./">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="assets/favicon.png">
  <link rel="stylesheet" data-bryntum-theme/>
</head>
<body>
  <app-root></app-root>
<script>
	// This script is for internal Bryntum examples browser functionality. Should be removed
	if (window.location.pathname.includes('/examples/') && !/examples\/.*\/dist/.test(window.location.pathname)) {
		window.location.href = 'dist/' + window.location.search;
	}
	else {
		document.querySelector('link[data-bryntum-theme=""]').href = "assets/themes/material3-light.css";
	}
</script>
</body>
</html>
